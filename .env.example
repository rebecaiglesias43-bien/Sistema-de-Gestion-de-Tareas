# Puerto en el que escucha el servidor HTTP
PUERTO=3000

# Cadena de conexión a PostgreSQL
URL_BASE_DATOS=postgresql://usuario:contrasena@localhost:5432/gestion_tareas

# Secreto para firmar los JSON Web Tokens (cambiar por un valor aleatorio y seguro)
SECRETO_JWT=cambia_este_valor_por_un_secreto_largo_y_aleatorio

# Tiempo de expiración de los tokens (ej. 1h, 30m, 7d)
EXPIRACION_JWT=1h
